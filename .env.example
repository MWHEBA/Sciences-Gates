# ============================================================================
# DJANGO SETTINGS
# ============================================================================
# Secret key for Django (generate a new one for production)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode (MUST be False in production)
DEBUG=False

# Allowed hosts (comma-separated list of domains)
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,www.your-domain.com

# ============================================================================
# DATABASE CONFIGURATION (MySQL/MariaDB)
# ============================================================================
# Database engine (use django.db.backends.mysql for cPanel)
DB_ENGINE=django.db.backends.mysql

# Database name (created in cPanel MySQL Databases)
DB_NAME=science_gates

# Database user (created in cPanel MySQL Databases)
DB_USER=science_gates_user

# Database password (strong password recommended)
DB_PASSWORD=your-strong-database-password

# Database host (usually localhost for cPanel)
DB_HOST=localhost

# Database port (usually 3306 for MySQL)
DB_PORT=3306

# ============================================================================
# SECURITY SETTINGS (Production)
# ============================================================================
# Redirect HTTP to HTTPS (set to True in production with SSL)
SECURE_SSL_REDIRECT=True

# HSTS (HTTP Strict Transport Security) seconds
# Set to 31536000 (1 year) after testing SSL configuration
SECURE_HSTS_SECONDS=31536000

# Session cookie secure flag (requires HTTPS)
SESSION_COOKIE_SECURE=True

# CSRF cookie secure flag (requires HTTPS)
CSRF_COOKIE_SECURE=True

# ============================================================================
# EMAIL CONFIGURATION (for lead notifications)
# ============================================================================
# Email backend (use SMTP for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP server host (Gmail example)
EMAIL_HOST=smtp.gmail.com

# SMTP server port (587 for TLS, 465 for SSL)
EMAIL_PORT=587

# Use TLS for email (True for port 587, False for port 465)
EMAIL_USE_TLS=True

# Email account username (Gmail address or SMTP username)
EMAIL_HOST_USER=your-email@gmail.com

# Email account password (Gmail App Password, not regular password)
EMAIL_HOST_PASSWORD=your-app-password

# Default from email address
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# Admin email address (receives lead notifications)
ADMIN_EMAIL=admin@your-domain.com

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================
# Cache backend (file-based by default for cPanel compatibility)
CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache

# Cache location (directory path for file-based cache)
CACHE_LOCATION=/home/username/public_html/science-gates/cache

# ============================================================================
# IMAGE UPLOAD SETTINGS
# ============================================================================
# Maximum upload file size in bytes (5MB = 5242880 bytes)
MAX_UPLOAD_SIZE=5242880

# Maximum image width in pixels (images wider than this will be resized)
MAX_IMAGE_WIDTH=1920

# ============================================================================
# SITE CONFIGURATION
# ============================================================================
# Site name (displayed in templates and emails)
SITE_NAME=بوابات العلوم للدراسة في ماليزيا

# Site URL (used for absolute URLs in emails and sitemaps)
SITE_URL=https://your-domain.com

# ============================================================================
# WordPress Importer Settings
WP_IMPORTER_BASE_URL=https://old-site.com
WP_IMPORTER_SECRET_KEY=sg_import_secure_token_2026
WP_IMPORTER_TIMEOUT=30
# Gemini API Key from Google AI Studio (needed for AI rewrite and migration of majors)
GEMINI_API_KEY=


# ============================================================================
# GOOGLE ANALYTICS & SEARCH CONSOLE
# ============================================================================
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Get from: https://analytics.google.com/ → Admin → Data Streams
GA4_MEASUREMENT_ID=

# Google Search Console Verification Code (meta tag verification)
# Get from: https://search.google.com/search-console → Settings → Verification
GOOGLE_SITE_VERIFICATION=

